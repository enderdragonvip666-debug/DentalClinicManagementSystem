<c:set var="lastAdmin" value="${not empty edit and edit.roleName == 'Administrator' and edit.status == 'ACTIVE' and activeAdminCount le 1}"/>
<form method="post" action="${ctx}/admin/users" class="admin-editor card" autocomplete="off">
  <div class="admin-editor-heading">
    <div class="admin-editor-icon" aria-hidden="true">${empty edit ? '➕' : '✏️'}</div>
    <div>
      <h3>${empty edit ? 'Tạo tài khoản mới' : 'Sửa thông tin tài khoản'}</h3>
      <p class="muted">${empty edit ? 'Nhập thông tin để cấp tài khoản mới.' : 'Cập nhật thông tin, vai trò hoặc trạng thái tài khoản.'}</p>
    </div>
  </div>
  <c:if test="${lastAdmin}">
    <div class="admin-role-warning" role="note">
      <strong>Quản trị viên duy nhất đang hoạt động</strong>
      <p>Không thể đổi vai trò hoặc khóa tài khoản này khi hệ thống chỉ còn một quản trị viên đang hoạt động.</p>
    </div>
  </c:if>
  <input type="hidden" name="accountId" value="${empty edit ? 0 : edit.accountId}">
  <div class="admin-form-grid">
    <label>Họ và tên<input name="fullName" maxlength="150" autocomplete="off" required value="<c:out value='${edit.fullName}'/>"></label>
    <label>Số điện thoại<input name="phone" type="tel" inputmode="tel" autocomplete="off"
      pattern="0[0-9]{9,10}" required ${empty edit ? '' : 'readonly'} value="<c:out value='${edit.phone}'/>"></label>
    <label>Email (không bắt buộc)<input name="email" type="email" maxlength="150" autocomplete="off" value="<c:out value='${edit.email}'/>"></label>
    <label>${empty edit ? 'Mật khẩu (ít nhất 8 ký tự)' : 'Mật khẩu mới (để trống nếu giữ nguyên)'}
      <input name="password" type="password" autocomplete="new-password" minlength="8" ${empty edit ? 'required' : ''}>
    </label>
    <label>Vai trò
      <c:if test="${lastAdmin}"><input type="hidden" name="role" value="Administrator"></c:if>
      <select name="role" ${lastAdmin ? 'disabled' : ''}>
        <c:forEach var="r" items="${roles}">
          <option value="${r.roleName}" ${edit.roleName == r.roleName ? 'selected' : ''}>${rl[r.roleName]}</option>
        </c:forEach>
      </select>
    </label>
    <label>Trạng thái
      <c:if test="${lastAdmin}"><input type="hidden" name="status" value="ACTIVE"></c:if>
      <select name="status" ${lastAdmin ? 'disabled' : ''}>
        <c:forEach var="s" items="${statuses}">
          <option value="${s}" ${(empty edit ? 'ACTIVE' : edit.status) == s ? 'selected' : ''}>${st[s]}</option>
        </c:forEach>
      </select>
    </label>
  </div>
  <div class="admin-editor-actions">
    <button class="btn" type="submit">${empty edit ? 'Tạo tài khoản' : 'Lưu thay đổi'}</button>
    <c:choose>
      <c:when test="${empty edit}"><a class="btn ghost" href="${ctx}/admin/users">Quay lại</a></c:when>
      <c:otherwise><button type="button" class="btn ghost" data-close-admin-edit>Hủy</button></c:otherwise>
    </c:choose>
  </div>
  <p class="admin-form-tip">Hệ thống phải luôn còn ít nhất một tài khoản Administrator ACTIVE.</p>
</form>
