<form method="post" action="${ctx}/admin/services" class="admin-editor card" autocomplete="off">
  <div class="admin-editor-heading">
    <div class="admin-editor-icon" aria-hidden="true">${empty edit ? '🦷' : '✏️'}</div>
    <div>
      <h3>${empty edit ? 'Thêm dịch vụ nha khoa' : 'Sửa dịch vụ nha khoa'}</h3>
      <p class="muted">${empty edit ? 'Thêm một dịch vụ để sử dụng khi đặt lịch và khám.' : 'Cập nhật dịch vụ đang có.'}</p>
    </div>
  </div>
  <input type="hidden" name="serviceId" value="${empty edit ? 0 : edit.serviceId}">
  <div class="admin-form-grid">
    <label class="admin-field-wide">Tên dịch vụ (tối đa 100 ký tự)
      <input name="name" maxlength="100" required value="<c:out value='${edit.name}'/>">
    </label>
    <label>Phí (VND, không âm)
      <input name="fee" type="number" min="0" step="0.01" required
             value="<fmt:formatNumber value='${edit.fee}' groupingUsed='false' maxFractionDigits='2'/>">
    </label>
    <label>Trạng thái
      <select name="status">
        <option value="ACTIVE" ${edit.status == 'ACTIVE' || empty edit ? 'selected' : ''}>Hoạt động</option>
        <option value="INACTIVE" ${edit.status == 'INACTIVE' ? 'selected' : ''}>Ngừng hoạt động</option>
      </select>
    </label>
  </div>
  <c:if test="${not empty edit}"><p class="note">Thay đổi phí không ảnh hưởng đến các hóa đơn đã tạo.</p></c:if>
  <div class="admin-editor-actions">
    <button class="btn" type="submit">${empty edit ? 'Thêm dịch vụ' : 'Lưu thay đổi'}</button>
    <c:choose>
      <c:when test="${empty edit}"><a class="btn ghost" href="${ctx}/admin/services">Quay lại</a></c:when>
      <c:otherwise><button type="button" class="btn ghost" data-close-admin-edit>Hủy</button></c:otherwise>
    </c:choose>
  </div>
  <p class="admin-form-tip">Dịch vụ ACTIVE được hiển thị khi người dùng đặt lịch khám.</p>
</form>
