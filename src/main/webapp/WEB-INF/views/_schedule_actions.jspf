<div class="acts schedule-actions request-actions">
  <c:choose>
    <c:when test="${r.status == 'REQUESTED'}">
      <c:if test="${r.apptDateIso == todayIso}">
        <form method="post" action="${ctx}/checkin" class="inline">
          <input type="hidden" name="requestId" value="${r.requestId}">
          <input type="hidden" name="date" value="${sel.value}">
          <input type="hidden" name="status" value="${statusFilter}">
          <button class="btn sm">Check-in</button>
        </form>
      </c:if>
      <form method="post" action="${ctx}/requests" class="inline" onsubmit="return confirm('Bạn có chắc muốn hủy lịch hẹn này không?');">
        <input type="hidden" name="requestId" value="${r.requestId}">
        <input type="hidden" name="date" value="${sel.value}">
        <input type="hidden" name="status" value="${statusFilter}">
        <button class="btn danger sm">Hủy</button>
      </form>
    </c:when>
    <c:otherwise>
      <span class="muted">Đã check-in</span>
    </c:otherwise>
  </c:choose>
</div>
