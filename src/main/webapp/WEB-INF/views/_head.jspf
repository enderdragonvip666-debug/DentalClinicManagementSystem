<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<c:set var="role" value="${sessionScope.user.roleName}"/>
<c:set var="st" value="${{'REQUESTED':'Chờ check-in','ARRIVED':'Đã đến khám','CANCELLED':'Đã hủy','WAITING':'Đang chờ','IN_PROGRESS':'Đang khám','AWAITING_PAYMENT':'Chờ thanh toán','PAID':'Đã thanh toán','UNPAID':'Chưa thanh toán','COMPLETED':'Hoàn thành','ACTIVE':'Hoạt động','INACTIVE':'Ngừng hoạt động','SUSPENDED':'Bị khóa'}}"/>
<c:set var="sh" value="${{'MORNING':'Ca sáng','AFTERNOON':'Ca chiều'}}"/>
<c:set var="rl" value="${{'Patient':'Bệnh nhân','Dental Assistant':'Trợ lý nha sĩ','Dentist':'Nha sĩ','Administrator':'Quản trị viên'}}"/>
<!DOCTYPE html>
<html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title><c:out value="${title}"/> · DCMS</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="${ctx}/assets/style.css?v=9"><script>var CTX='${ctx}';</script><script src="${ctx}/assets/app.js?v=6" defer></script></head>
<body>
<header class="top"><div class="bar">
  <a class="brand" href="${ctx}/home"><span class="logo">🦷</span>Dental Clinic</a>
  <nav>
    <c:choose>
      <c:when test="${role == 'Patient'}"><a href="${ctx}/my-requests">Lịch khám của tôi</a><a href="${ctx}/consult">Đặt lịch khám</a><a href="${ctx}/history">Lịch sử điều trị</a></c:when>
      <c:when test="${role == 'Dental Assistant'}"><a href="${ctx}/requests">Lịch khám</a><a href="${ctx}/reschedule">Đổi lịch</a><a href="${ctx}/checkout">Thanh toán</a><a href="${ctx}/history">Lịch sử điều trị</a></c:when>
      <c:when test="${role == 'Dentist'}"><a href="${ctx}/patients">Danh sách bệnh nhân</a></c:when>
      <c:when test="${role == 'Administrator'}"><a href="${ctx}/admin/users">Người dùng</a><a href="${ctx}/admin/services">Dịch vụ nha khoa</a></c:when>
      <c:otherwise><a href="${ctx}/home">Trang chủ</a><a href="${ctx}/consult">Đặt lịch khám</a></c:otherwise>
    </c:choose>
  </nav>
  <div class="who">
    <c:choose>
      <c:when test="${not empty sessionScope.user}">
        <span><c:out value="${sessionScope.user.fullName}"/> <em>(${rl[role]})</em></span>
        <a href="${ctx}/password" data-open-password>Đổi mật khẩu</a>
        <form method="post" action="${ctx}/logout" class="inline"><button class="link">Đăng xuất</button></form>
      </c:when>
      <c:otherwise><a class="btn sm" href="${ctx}/consult">Đặt lịch khám</a><a href="${ctx}/login">Đăng nhập</a><a href="${ctx}/signup">Đăng ký</a></c:otherwise>
    </c:choose>
  </div>
</div></header>
<c:set var="authPage" value="${pageContext.request.servletPath == '/login' or pageContext.request.servletPath == '/signup'}"/>
<main class="wrap ${authPage ? 'auth-wrap' : ''}">
<c:if test="${not empty ok}"><div class="alert ok"><c:out value="${ok}"/></div></c:if>
<c:if test="${not empty err}"><div class="alert err"><c:out value="${err}"/></div></c:if>
